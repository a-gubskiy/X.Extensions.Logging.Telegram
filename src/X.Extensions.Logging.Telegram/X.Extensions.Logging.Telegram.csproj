<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <Version>3.0.0</Version>
        <Title>X.Extensions.Logging.Telegram</Title>
        <Description>Telegram logging provider for Microsoft.Extensions.Logging</Description>
        <PackageTags>telegram logging log logs</PackageTags>
        <Authors>Andrew Gubskiy, Vladyslav Bardin</Authors>
        <Company>Ukrainian .NET Developer Community</Company>
        <Copyright>Andrew Gubskiy, Vladyslav Bardin © 2026</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageIcon>x-extensions.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/a-gubskiy/X.Extensions.Logging.Telegram</RepositoryUrl>
        <PackageProjectUrl>https://github.com/a-gubskiy/X.Extensions.Logging.Telegram</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
        <None Include="../../LICENSE.md" Pack="true" PackagePath="" />
        <None Include="../../x-extensions.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.14" />
        <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
    </ItemGroup>

</Project>
