<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <Version>3.0.0</Version>
        <Title>X.Extensions.Logging.Telegram</Title>
        <Description>Telegram logging provider for Microsoft.Extensions.Logging</Description>
        <PackageTags>telegram logging log logs</PackageTags>
        <Authors>Andrew Gubskiy, Vladyslav Bardin</Authors>
        <Company>Ukrainian .NET Developer Community</Company>
        <Copyright>Andrew Gubskiy, Vladyslav Bardin © 2026</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>x-extensions.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/a-gubskiy/X.Extensions.Logging.Telegram</RepositoryUrl>
        <PackageProjectUrl>https://github.com/a-gubskiy/X.Extensions.Logging.Telegram</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
        <None Include="../../NOTICE" Pack="true" PackagePath="" />
        <None Include="../../x-extensions.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
        <PackageReference Include="Telegram.Bot" Version="22.10.5" />
    </ItemGroup>

    <!-- Keep LTS consumers (.NET 10, .NET Framework) on Microsoft.Extensions 10.x;
         only the net11.0 build depends on Microsoft.Extensions 11.x. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
    </ItemGroup>

</Project>
